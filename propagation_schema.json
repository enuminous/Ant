{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ANT Propagation Risk Record",
  "type": "object",
  "required": [
    "machine_version",
    "timestamp",
    "network_id",
    "network_risk"
  ],
  "properties": {
    "machine_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "network_id": {
      "type": "string"
    },
    "network_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "propagation_pressure_mean": {
      "type": "number"
    },
    "bottleneck_concentration": {
      "type": "number"
    },
    "network_local_risk": {
      "type": "number"
    },
    "propagation_velocity": {
      "type": "number"
    }
  }
}